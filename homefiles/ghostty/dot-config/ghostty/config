# ============ Configuration ==========
shell-integration = zsh
command = zsh

scrollback-limit = 50000
mouse-hide-while-typing = true
copy-on-select = clipboard
quit-after-last-window-closed = true

auto-update = check

window-inherit-working-directory = false
working-directory = home

# ============ Styling ================
theme = dark:Catppuccin Mocha,light:Catppuccin Latte
font-family = "font-jetbrains-mono-nerd-font"
font-size = 14
adjust-cell-height = 24%

window-decoration = true
window-padding-x = 10
window-padding-y = 10

background-opacity = 0.92
background-blur-radius = 20

unfocused-split-fill = 080808
unfocused-split-opacity = 0.3
split-divider-color = 333333

#macos-titlebar-style = transparent
macos-icon = custom-style
macos-icon-frame = plastic
macos-icon-ghost-color = #000000
macos-icon-screen-color = #333333,#000000

# ============ Key Binding ============
macos-option-as-alt = true

keybind = alt+d=new_split:right
keybind = alt+shift+d=new_split:down
keybind = ctrl+w=close_surface

keybind = cmd+shift+s=prompt_surface_title

keybind = global:cmd+backquote=toggle_quick_terminal
keybind = global:cmd+§=toggle_quick_terminal
