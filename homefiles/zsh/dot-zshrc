export PATH=$HOME/bin:$HOME/.local/bin:/usr/local/bin:$PATH
export ZSH="$HOME/.oh-my-zsh"

zstyle ':omz:update' mode auto
zstyle ':omz:update' frequency 14

ZSH_THEME="robbyrussell"
plugins=(macos ssh git brew 1password azure dotnet docker docker-compose terraform themes)

source $ZSH/oh-my-zsh.sh

# Default Editor
if [[ -n $SSH_CONNECTION ]]; then
  export EDITOR='vim'
else
  export EDITOR='zed'
fi
export VISUAL=$EDITOR

export TERM="xterm-256color"

# ZSH Autosuggestions
source $HOMEBREW_PREFIX/share/zsh-autosuggestions/zsh-autosuggestions.zsh

# NVM for Node and npm
export NVM_DIR="$HOME/.nvm"
[ -s "$NVM_DIR/nvm.sh" ] && \. "$NVM_DIR/nvm.sh"  # This loads nvm
[ -s "$NVM_DIR/bash_completion" ] && \. "$NVM_DIR/bash_completion"  # This loads nvm bash_completion

# Git Kraken (Open current directory in GitKraken)
alias kraken='open -na "GitKraken" --args -p $(pwd)'

# Terraform
autoload -U +X bashcompinit && bashcompinit
complete -o nospace -C /opt/homebrew/bin/terraform terraform
alias tf='terraform'

# Syntax highlighting
#ZSH_HIGHLIGHT_DIR="/usr/local/share/zsh-syntax-highlighting"
#export ZSH_HIGHLIGHT_HIGHLIGHTERS_DIR="${ZSH_HIGHLIGHT_DIR}/highlighters"
#source ${ZSH_HIGHLIGHT_DIR}/zsh-syntax-highlighting.zsh
source $(brew --prefix)/share/zsh-syntax-highlighting/zsh-syntax-highlighting.zsh

# Tools
alias ytdown='yt-dlp'
alias tunneling='$HOME/.config/tunnelling/tunnelling.sh'
alias gristory='history | grep '
alias cx='codex'

# bun completions
[ -s "/Users/argael/.bun/_bun" ] && source "/Users/argael/.bun/_bun"

# bun
export BUN_INSTALL="$HOME/.bun"
export PATH="$BUN_INSTALL/bin:$PATH"

# Local machine overrides (secrets, tokens, host-specific exports)
[ -f "$HOME/.zshrc.local" ] && source "$HOME/.zshrc.local"
