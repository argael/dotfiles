export TERM="xterm-256color"
export PATH=$HOME/bin:/usr/local/bin:$HOME/Library/Python/3.9/bin/:$PATH
export ZSH="$HOME/.oh-my-zsh"


# Oh My ZSH -------------------------------------------------------------------
zstyle ':omz:update' mode auto      # update automatically without asking
ZSH_THEME="robbyrussell"
DISABLE_AUTO_TITLE="true"
ENABLE_CORRECTION="true"
plugins=(macos ssh git brew docker docker-compose terraform themes)
source $ZSH/oh-my-zsh.sh


# Oh My Posh ------------------------------------------------------------------
if [ "$TERM_PROGRAM" != "Apple_Terminal" ]; then
  eval "$(oh-my-posh init zsh --config ~/.config/oh-my-posh/krkn.omp.json)"
fi


# Zsh Syntax Highlighting -----------------------------------------------------
source /opt/homebrew/share/zsh-syntax-highlighting/zsh-syntax-highlighting.zsh


# Homebrew --------------------------------------------------------------------
export HOMEBREW_NO_INSTALL_CLEANUP=1
export HOMEBREW_NO_ENV_HINTS=1


# Editor ----------------------------------------------------------------------
if [[ -n $SSH_CONNECTION ]]; then
  export EDITOR='vim'
else
  export EDITOR='zed'
fi


# Autocomplete ----------------------------------------------------------------
source $HOMEBREW_PREFIX/share/zsh-autosuggestions/zsh-autosuggestions.zsh


# N
export N_PREFIX="$HOME/n"; [[ :$PATH: == *":$N_PREFIX/bin:"* ]] || PATH+=":$N_PREFIX/bin"  # Added by n-install (see http://git.io/n-install-repo).

## Terraform
autoload -U +X bashcompinit && bashcompinit
complete -o nospace -C /usr/local/bin/terraform terraform

alias tfw="terraform workspace"
alias tfpo="terraform plan -out tfplan"
alias tfpa="terraform apply tfplan"
alias tfap="tfpa"

export NVM_DIR="$HOME/.nvm"
[ -s "$NVM_DIR/nvm.sh" ] && \. "$NVM_DIR/nvm.sh"  # This loads nvm
[ -s "$NVM_DIR/bash_completion" ] && \. "$NVM_DIR/bash_completion"  # This loads nvm bash_completion

# Git Kraken (Open current directory in GitKraken)
alias kraken='open -na "GitKraken" --args -p $(pwd)'

# Esphome
eval "$(register-python-argcomplete esphome)"

# Load Angular CLI autocompletion.
source <(ng completion script)

# Tools
alias ytdown='yt-dlp'
alias tunneling='$HOME/.config/tunnelling/tunnelling.sh'
alias gristory='history | grep '
alias cx='codex'
