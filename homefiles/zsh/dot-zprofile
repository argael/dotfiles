
# Oh My Posh - Prompt customization
if [ "$TERM_PROGRAM" != "Apple_Terminal" ]; then
    eval "$(oh-my-posh init zsh --config ~/.config/oh-my-posh/catppuccin.omp.json)"
fi

# Homebrew
eval "$(/usr/local/bin/brew shellenv)"

# Zoxide
if (( $+commands[zoxide] )); then
    eval "$(zoxide init zsh --cmd cd)"
fi

# Direnv
# eval "$(direnv hook zsh)"

# FZF
if (( $+commands[fzf] )); then
    source <(fzf --zsh)
fi


# Obsidian CLI
export PATH="$PATH:/Applications/Obsidian.app/Contents/MacOS"

# Added by OrbStack: command-line tools and integration
# This won't be added again if you remove it.
source ~/.orbstack/shell/init.zsh 2>/dev/null || :

# Sail (for Laravel)
sail() {
  local dir="$PWD"

  while [ "$dir" != "/" ]; do
    if [ -f "$dir/artisan" ] || [ -f "$dir/.env" ]; then
      if [ -x "$dir/sail" ]; then
        (cd "$dir" && "$dir/sail" "$@")
        return $?
      fi
      if [ -x "$dir/vendor/bin/sail" ]; then
        (cd "$dir" && "$dir/vendor/bin/sail" "$@")
        return $?
      fi
      echo "Laravel Root detected but Sail binary not found." >&2
      return 1
    fi
    dir="$(dirname "$dir")"
  done

  echo "Laravel Root not found (artisan/.env missing)." >&2
  return 1
}
