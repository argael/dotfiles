
# Oh My Posh - Prompt customization
if [ "$TERM_PROGRAM" != "Apple_Terminal" ]; then
    eval "$(oh-my-posh init zsh --config ~/.config/oh-my-posh/catppuccin.omp.json)"
fi

# Homebrew
eval "$(/opt/homebrew/bin/brew shellenv)"

# Zoxide
if (( $+commands[zoxide] )); then
    eval "$(zoxide init zsh --cmd cd)"
fi

# Direnv
eval "$(direnv hook zsh)"

# FZF
if (( $+commands[fzf] )); then
    source <(fzf --zsh)
fi

# Git Kraken (Open project directory in GitKraken)
unalias gk 2>/dev/null
kraken() {
  local target_path repo_root
  target_path="${1:-.}"

  if [[ ! -e "$target_path" ]]; then
    echo "kraken: path not found: $target_path" >&2
    return 1
  fi

  repo_root="$(git -C "$target_path" rev-parse --show-toplevel 2>/dev/null)"
  if [[ -z "$repo_root" ]]; then
    echo "kraken: not a Git repository: $target_path" >&2
    return 1
  fi

  open -na "GitKraken" --args -p "$repo_root"
}

